{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socrv.local/schema/testlist.schema.json",
  "title": "SocRV regression test list",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tests"],
  "properties": {
    "schema_version": {"const": 1},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "target", "suite", "checker", "max_cycles"],
        "properties": {
          "name": {"type": "string"},
          "target": {"enum": ["unit", "cpu", "soc"]},
          "suite": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "image": {"type": "string"},
          "checker": {"type": "string"},
          "max_cycles": {"type": "integer", "minimum": 1},
          "max_wall_seconds": {"type": "integer", "minimum": 1},
          "seed": {"type": "integer", "minimum": 0},
          "uart_command": {"type": "string", "minLength": 1},
          "uart_prompt": {"type": "string", "minLength": 1},
          "uart_prompt_timeout": {"type": "integer", "minimum": 1},
          "uart_expect": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "uart_reject": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "performance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "iterations"],
            "properties": {
              "enabled": {"type": "boolean"},
              "iterations": {"type": "integer", "minimum": 1}
            }
          },
          "difftest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "backend", "mode"],
            "properties": {
              "enabled": {"type": "boolean"},
              "backend": {"const": "spike"},
              "mode": {"enum": ["ram-strict", "soc-mmio"]},
              "isa": {"type": "string", "minLength": 1}
            }
          },
          "model": {"type": "object"}
        }
      }
    }
  }
}
