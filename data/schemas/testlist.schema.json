{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socrv.local/schema/testlist.schema.json",
  "title": "SocRV regression test list",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tests"],
  "properties": {
    "schema_version": {"const": 1},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "target", "suite", "checker", "max_cycles"],
        "properties": {
          "name": {"type": "string"},
          "target": {"enum": ["unit", "cpu", "soc"]},
          "suite": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "image": {"type": "string"},
          "checker": {"type": "string"},
          "max_cycles": {"type": "integer", "minimum": 1},
          "seed": {"type": "integer", "minimum": 0},
          "model": {"type": "object"}
        }
      }
    }
  }
}
