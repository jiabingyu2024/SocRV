{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socrv.local/schema/board.schema.json",
  "title": "SocRV FPGA board facts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "vendor",
    "part",
    "top",
    "clock",
    "constraints"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string"},
    "vendor": {"const": "xilinx"},
    "part": {"type": "string"},
    "top": {"type": "string"},
    "clock": {
      "type": "object",
      "required": ["frequency_hz"],
      "properties": {
        "frequency_hz": {"type": "integer", "minimum": 1},
        "differential": {"type": "boolean"},
        "soc_frequency_hz": {"type": "integer", "minimum": 1},
        "core_frequency_hz": {"type": "integer", "minimum": 1},
        "peripheral_frequency_hz": {"type": "integer", "minimum": 1}
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
