{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socrv.local/schema/result.schema.json",
  "title": "SocRV run result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "kind",
    "status",
    "target"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"type": "string"},
    "target": {"type": "string"},
    "test": {"type": "string"},
    "profile": {"type": "string"},
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "TIMEOUT",
        "ASSERTION",
        "DIFF_MISMATCH",
        "BUILD_ERROR",
        "CONFIG_ERROR",
        "CRASH",
        "NO_RESULT",
        "UNSUPPORTED"
      ]
    },
    "seed": {"type": "integer", "minimum": 0},
    "cycles": {"type": "integer", "minimum": 0},
    "commits": {"type": "integer", "minimum": 0},
    "ipc": {"type": "number", "minimum": 0},
    "exit_reason": {"type": "string"},
    "max_cycles": {"type": "integer", "minimum": 1},
    "image": {"type": "string"},
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "passed",
        "message",
        "prompt_seen",
        "prompt_cycle",
        "prompt_count",
        "command_sent",
        "command_cycle",
        "command_complete",
        "framing_error",
        "decoded_bytes",
        "missing",
        "forbidden_seen"
      ],
      "properties": {
        "name": {"type": "string"},
        "passed": {"type": "boolean"},
        "message": {"type": "string"},
        "prompt_seen": {"type": "boolean"},
        "prompt_cycle": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "prompt_count": {"type": "integer", "minimum": 0},
        "command_sent": {"type": "boolean"},
        "command_cycle": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "command_complete": {"type": "boolean"},
        "framing_error": {"type": "boolean"},
        "decoded_bytes": {"type": "integer", "minimum": 0},
        "missing": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_seen": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "complete",
        "iterations",
        "start_cycle",
        "end_cycle",
        "cycles",
        "commits",
        "zero_retire_cycles",
        "single_retire_cycles",
        "dual_retire_cycles",
        "hpm_icache_misses",
        "hpm_load_misses",
        "hpm_store_misses",
        "hpm_branch_mispredicts",
        "hpm_decode_branch_mispredicts",
        "hpm_store_load_forwarding_failures",
        "hpm_memory_dependency_mispredicts",
        "stall_icache_cycles",
        "stall_decode_cycles",
        "stall_rename_cycles",
        "stall_backend_cycles",
        "recovery_cycles",
        "recovery_phase0_cycles",
        "recovery_phase1_cycles",
        "recovery_start_cycles",
        "recovery_rmt_cycles",
        "recovery_iq_return_cycles",
        "recovery_replay_flush_cycles",
        "recovery_wakeup_flush_cycles",
        "recovery_unable_start_cycles",
        "recovery_commit_exception_cycles",
        "recovery_rw_exception_cycles",
        "recovery_flush_all_cycles",
        "recovery_active_list_cycles",
        "observed_branch_events",
        "observed_branch_mispredicts",
        "observed_conditional_mispredicts",
        "observed_decode_corrections",
        "branch_mispredict_hotspots",
        "rename_no_physreg_cycles",
        "rename_no_iq_cycles",
        "rename_no_rob_cycles",
        "rename_no_lsq_cycles",
        "rename_serialize_cycles",
        "zero_dispatch_cycles",
        "single_dispatch_cycles",
        "dual_dispatch_cycles",
        "zero_issue_cycles",
        "single_issue_cycles",
        "multi_issue_cycles",
        "ipc",
        "seconds",
        "cycles_per_iteration",
        "commits_per_iteration",
        "iterations_per_second"
      ],
      "properties": {
        "requested": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "iterations": {"type": "integer", "minimum": 0},
        "start_cycle": {"type": ["integer", "null"], "minimum": 0},
        "end_cycle": {"type": ["integer", "null"], "minimum": 0},
        "cycles": {"type": ["integer", "null"], "minimum": 0},
        "commits": {"type": ["integer", "null"], "minimum": 0},
        "zero_retire_cycles": {"type": ["integer", "null"], "minimum": 0},
        "single_retire_cycles": {"type": ["integer", "null"], "minimum": 0},
        "dual_retire_cycles": {"type": ["integer", "null"], "minimum": 0},
        "hpm_icache_misses": {"type": ["integer", "null"], "minimum": 0},
        "hpm_load_misses": {"type": ["integer", "null"], "minimum": 0},
        "hpm_store_misses": {"type": ["integer", "null"], "minimum": 0},
        "hpm_branch_mispredicts": {"type": ["integer", "null"], "minimum": 0},
        "hpm_decode_branch_mispredicts": {"type": ["integer", "null"], "minimum": 0},
        "hpm_store_load_forwarding_failures": {"type": ["integer", "null"], "minimum": 0},
        "hpm_memory_dependency_mispredicts": {"type": ["integer", "null"], "minimum": 0},
        "stall_icache_cycles": {"type": ["integer", "null"], "minimum": 0},
        "stall_decode_cycles": {"type": ["integer", "null"], "minimum": 0},
        "stall_rename_cycles": {"type": ["integer", "null"], "minimum": 0},
        "stall_backend_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_phase0_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_phase1_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_start_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_rmt_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_iq_return_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_replay_flush_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_wakeup_flush_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_unable_start_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_commit_exception_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_rw_exception_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_flush_all_cycles": {"type": ["integer", "null"], "minimum": 0},
        "recovery_active_list_cycles": {"type": ["integer", "null"], "minimum": 0},
        "observed_branch_events": {"type": ["integer", "null"], "minimum": 0},
        "observed_branch_mispredicts": {"type": ["integer", "null"], "minimum": 0},
        "observed_conditional_mispredicts": {"type": ["integer", "null"], "minimum": 0},
        "observed_decode_corrections": {"type": ["integer", "null"], "minimum": 0},
        "branch_mispredict_hotspots": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pc",
              "executed",
              "mispredicts",
              "conditional_mispredicts",
              "decode_corrections"
            ],
            "properties": {
              "pc": {"type": "integer", "minimum": 0},
              "executed": {"type": "integer", "minimum": 0},
              "mispredicts": {"type": "integer", "minimum": 0},
              "conditional_mispredicts": {"type": "integer", "minimum": 0},
              "decode_corrections": {"type": "integer", "minimum": 0}
            }
          }
        },
        "rename_no_physreg_cycles": {"type": ["integer", "null"], "minimum": 0},
        "rename_no_iq_cycles": {"type": ["integer", "null"], "minimum": 0},
        "rename_no_rob_cycles": {"type": ["integer", "null"], "minimum": 0},
        "rename_no_lsq_cycles": {"type": ["integer", "null"], "minimum": 0},
        "rename_serialize_cycles": {"type": ["integer", "null"], "minimum": 0},
        "zero_dispatch_cycles": {"type": ["integer", "null"], "minimum": 0},
        "single_dispatch_cycles": {"type": ["integer", "null"], "minimum": 0},
        "dual_dispatch_cycles": {"type": ["integer", "null"], "minimum": 0},
        "zero_issue_cycles": {"type": ["integer", "null"], "minimum": 0},
        "single_issue_cycles": {"type": ["integer", "null"], "minimum": 0},
        "multi_issue_cycles": {"type": ["integer", "null"], "minimum": 0},
        "ipc": {"type": ["number", "null"], "minimum": 0},
        "seconds": {"type": ["number", "null"], "minimum": 0},
        "cycles_per_iteration": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "commits_per_iteration": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "iterations_per_second": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "difftest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "passed",
        "backend",
        "backend_version",
        "mode",
        "isa",
        "compared_events",
        "retired_instructions",
        "mmio_syncs",
        "last_order",
        "log",
        "trace"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "passed": {"type": "boolean"},
        "backend": {"type": "string"},
        "backend_version": {"type": "string"},
        "mode": {"type": "string"},
        "isa": {"type": "string"},
        "compared_events": {"type": "integer", "minimum": 0},
        "retired_instructions": {"type": "integer", "minimum": 0},
        "mmio_syncs": {"type": "integer", "minimum": 0},
        "last_order": {"type": ["integer", "null"], "minimum": 0},
        "log": {"type": ["string", "null"]},
        "trace": {"type": ["string", "null"]}
      }
    },
    "artifacts": {"type": "object"},
    "failure": {"type": ["object", "null"]},
    "reproduce": {"type": "string"}
  }
}
