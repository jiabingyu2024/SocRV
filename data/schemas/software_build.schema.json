{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socrv.local/schema/software_build.schema.json",
  "title": "SocRV software build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "profile",
    "profile_kind",
    "score_candidate",
    "toolchain",
    "linker",
    "elf",
    "dependencies",
    "sources",
    "repository_dirty"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "software_build"},
    "profile": {"type": "string"},
    "profile_kind": {"type": "string"},
    "score_candidate": {"type": "boolean"},
    "toolchain": {"type": "object"},
    "linker": {"type": "string"},
    "elf": {"type": "object"},
    "dependencies": {"type": "array"},
    "sources": {"type": "array", "minItems": 1},
    "repository_dirty": {"type": "boolean"},
    "competition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "config", "entry_source"],
      "properties": {
        "mode": {"const": "core_main_replacement"},
        "config": {"$ref": "#/$defs/source_file"},
        "entry_source": {"$ref": "#/$defs/source_file"}
      }
    }
  },
  "$defs": {
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
