diff --git a/spike_cosim.cc b/spike_cosim.cc
index 6db405e..a2f06c5 100644
--- a/spike_cosim.cc
+++ b/spike_cosim.cc
@@ -636,3 +636,30 @@ void SpikeCosim::leave_nmi_mode() {
 }
 
 int SpikeCosim::get_insn_cnt() { return insn_cnt; }
+
+uint32_t SpikeCosim::get_pc() const {
+  return static_cast<uint32_t>(
+      processor->get_state()->pc & static_cast<reg_t>(0xffffffff));
+}
+
+uint32_t SpikeCosim::get_gpr(unsigned int index) const {
+  assert(index < 32);
+  return static_cast<uint32_t>(
+      processor->get_state()->XPR[index] & static_cast<reg_t>(0xffffffff));
+}
+
+uint32_t SpikeCosim::get_csr_value(int csr_num) {
+  return static_cast<uint32_t>(processor->get_csr(csr_num));
+}
+
+void SpikeCosim::force_pc(uint32_t value) {
+  processor->get_state()->pc = static_cast<reg_t>(value);
+}
+
+void SpikeCosim::force_privilege(uint32_t value) {
+  processor->set_privilege(static_cast<reg_t>(value));
+}
+
+void SpikeCosim::force_csr_value(int csr_num, uint32_t value) {
+  processor->put_csr(csr_num, static_cast<reg_t>(value));
+}
