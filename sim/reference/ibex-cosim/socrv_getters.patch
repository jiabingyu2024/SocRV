diff --git a/spike_cosim.h b/spike_cosim.h
index 5ccfa7a..73d9f10 100644
--- a/spike_cosim.h
+++ b/spike_cosim.h
@@ -105,6 +105,12 @@ class SpikeCosim : public simif_t, public Cosim {
   const std::vector<std::string> &get_errors() override;
   void clear_errors() override;
   int get_insn_cnt() override;
+  uint32_t get_pc() const;
+  uint32_t get_gpr(unsigned int index) const;
+  uint32_t get_csr_value(int csr_num);
+  void force_pc(uint32_t value);
+  void force_privilege(uint32_t value);
+  void force_csr_value(int csr_num, uint32_t value);
